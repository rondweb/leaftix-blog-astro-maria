---
import { siteConfig } from '../config/site';
import {
	defaultLocale,
	getLocalePath,
	getUi,
	type LocaleCode,
} from '../config/i18n';

const locale: LocaleCode = (Astro.currentLocale as LocaleCode) ?? defaultLocale;
const t = getUi(locale);

const { showCta = true } = Astro.props;
const currentYear = new Date().getFullYear();

const legalLinks = [
	{ href: getLocalePath('/cookies', locale), label: t.nav.cookies },
	{ href: getLocalePath('/privacy', locale), label: t.nav.privacy },
	{ href: getLocalePath('/terms', locale), label: t.nav.terms },
];
---

<footer class="shared-footer">
	<div class:list={['shared-footer-inner', !showCta && 'shared-footer-inner-no-cta']}>
		{
			showCta && (
				<div class="shared-footer-cta">
					<h2>{t.footer.ctaTitle}</h2>
					<p>{t.footer.ctaText}</p>
					<a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
				</div>
			)
		}

		<div class="shared-footer-meta">
			<div class="shared-footer-links">
				{
					siteConfig.socialLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					))
				}
			</div>
			<div class="shared-footer-note">
				<div class="shared-footer-legal">
					{legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
					<button
						class="footer-cookie-btn"
						type="button"
						onclick="window.dispatchEvent(new CustomEvent('leaftix:openCookieConsent'))"
					>
						{t.footer.cookiePreferences}
					</button>
				</div>
				<p>&copy; {currentYear} {siteConfig.name}. {t.footer.copyrightSuffix}</p>
			</div>
		</div>
	</div>
</footer>