---
// Localized pagination: /pt-BR/work/page/2, /es/work/page/2, …
// The reused page reads Astro.props (page/totalPages/visibleProjects), so the
// same props have to be provided for every locale here.
import WorkPagedPage from '../../../work/page/[page].astro';
import { projects, workPageSize } from '../../../../data/projects';
import { localeParams } from '../../../../config/i18n';

export function getStaticPaths() {
	const totalPages = Math.ceil(projects.length / workPageSize);
	const pageNumbers = Array.from(
		{ length: Math.max(totalPages - 1, 0) },
		(_, index) => index + 2
	);

	return localeParams().flatMap(({ params }) =>
		pageNumbers.map((pageNumber) => {
			const start = (pageNumber - 1) * workPageSize;
			const end = start + workPageSize;

			return {
				params: { ...params, page: String(pageNumber) },
				props: {
					page: pageNumber,
					totalPages,
					visibleProjects: projects.slice(start, end),
				},
			};
		})
	);
}
---

<WorkPagedPage />